{
  "name": "judo-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test:unit": "tsx --test \"src/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:styles": "scripts/test-styles.sh",
    "test:styles:update": "scripts/test-styles.sh --update-snapshots",
    "prepare": "husky",
    "deploy": "next build && wrangler deploy"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.34.9",
  "browserslist": [
    "extends @tanchu/browserslist-config"
  ],
  "dependencies": {
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "next": "^16.4.6",
    "next-intl": "^4.15.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanchu/agent-rules": "^0.2.0",
    "@tanchu/browserslist-config": "^0.1.0",
    "@tanchu/eslint-config": "^0.1.1",
    "@tanchu/stylelint-config": "^0.1.0",
    "@tanchu/tsconfig": "^0.1.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "fake-indexeddb": "^6.2.8",
    "husky": "^9.1.7",
    "knip": "^6.45.1",
    "lint-staged": "^17.6.1",
    "stylelint": "^18.0.0",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "wrangler": "^4.161.0"
  },
  "lint-staged": {
    "*.svg": "svgo --multipass"
  }
}
